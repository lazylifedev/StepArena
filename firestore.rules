rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /qaTelemetryDevices/{deviceId}/{subcollection}/{documentId} {
      allow read, write: if false;
    }
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function createTimes() { return request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time; }
    function updateTimes() { return request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time; }
    function times() { return resource == null ? createTimes() : updateTimes(); }
    function nn(v) { return v is number && v >= 0; }
    function optnn(v) { return v == null || nn(v); }
    function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function sid(v) { return v is string && v.matches('^[0-9a-f]{32}$'); }
    function operationId(v) { return v is string && v.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function v2(d) { return d.schemaVersion == 2 && sid(d.stableId) && d.backupGeneration is int && d.backupGeneration >= 1; }
    function currentGeneration(uid, d) {
      let parent = get(/databases/$(database)/documents/userBackups/$(uid)/versions/v2).data;
      return parent.schemaVersion == 2 && parent.childGenerationVersion == 1 && parent.backupStatus == 'in_progress'
        && d.backupGeneration == parent.backupGeneration;
    }
    function quality(v) { return v in ['MEASURED','ESTIMATED','RECOVERED','MIXED','UNKNOWN']; }

    function validRoot() {
        let d=request.resource.data;
        return d.keys().hasOnly(['schemaVersion','childGenerationVersion','minimumRestoreVersion','appVersionName','appVersionCode','databaseVersion','backupGeneration','backupStatus','backupStartedAt','backupCompletedAt','leaseVersion','backupOperationId','leaseUpdatedAt','localTimeZone','dailyCount','hourlyCount','sessionCount','challengeResultCount','leagueHistoryCount','leagueParticipantCount','seasonHistoryCount','integritySegmentCount','achievementCount','settingsCount','newestLocalDate','createdAt','updatedAt'])
          && d.keys().hasAll(['schemaVersion','childGenerationVersion','minimumRestoreVersion','appVersionName','appVersionCode','databaseVersion','backupGeneration','backupStatus','backupStartedAt','leaseVersion','backupOperationId','leaseUpdatedAt','localTimeZone','dailyCount','hourlyCount','sessionCount','challengeResultCount','leagueHistoryCount','leagueParticipantCount','seasonHistoryCount','integritySegmentCount','achievementCount','settingsCount','createdAt','updatedAt'])
          && d.schemaVersion == 2 && d.childGenerationVersion == 1 && d.minimumRestoreVersion == 2 && d.databaseVersion == 10
          && d.appVersionName is string && nn(d.appVersionCode) && d.backupGeneration is int && d.backupGeneration > 0
          && d.backupStatus in ['in_progress','complete'] && d.backupStartedAt is timestamp && d.localTimeZone is string
          && d.leaseVersion == 1 && operationId(d.backupOperationId) && d.leaseUpdatedAt is timestamp
          && nn(d.dailyCount) && nn(d.hourlyCount) && nn(d.sessionCount) && nn(d.challengeResultCount)
          && nn(d.leagueHistoryCount) && nn(d.leagueParticipantCount) && nn(d.seasonHistoryCount) && nn(d.integritySegmentCount) && nn(d.achievementCount) && nn(d.settingsCount)
          && (!('newestLocalDate' in d) || d.newestLocalDate == null || date(d.newestLocalDate))
          && (resource == null ? rootCreate(d) : rootUpdate(d))
          && (d.backupStatus == 'complete' ? d.backupCompletedAt == request.time : !('backupCompletedAt' in d));
    }

    function rootCreate(d) {
      return d.backupStatus == 'in_progress' && d.backupGeneration == 1
        && d.backupStartedAt == request.time && d.leaseUpdatedAt == request.time;
    }
    function staleLease() {
      return (('leaseVersion' in resource.data && resource.data.leaseVersion == 1
          && 'backupOperationId' in resource.data && operationId(resource.data.backupOperationId)
          && 'leaseUpdatedAt' in resource.data && resource.data.leaseUpdatedAt is timestamp
          && request.time >= resource.data.leaseUpdatedAt + duration.value(30, 'm'))
        || (!('leaseVersion' in resource.data) && !('backupOperationId' in resource.data)
          && !('leaseUpdatedAt' in resource.data) && resource.data.backupStartedAt is timestamp
          && request.time >= resource.data.backupStartedAt + duration.value(30, 'm')));
    }
    function rootUpdate(d) {
      return resource.data.schemaVersion == 2
        && (d.backupStatus == 'complete' ? rootComplete(d)
          : (resource.data.backupStatus == 'complete' ? rootBegin(d)
            : (rootHeartbeat(d) || rootTakeover(d))));
    }
    function rootBegin(d) {
      return d.backupGeneration == resource.data.backupGeneration + 1
        && (!('backupOperationId' in resource.data) || d.backupOperationId != resource.data.backupOperationId)
        && d.backupStartedAt == request.time && d.leaseUpdatedAt == request.time;
    }
    function rootTakeover(d) {
      return resource.data.backupStatus == 'in_progress' && staleLease()
        && d.backupGeneration == resource.data.backupGeneration + 1
        && (!('backupOperationId' in resource.data) || d.backupOperationId != resource.data.backupOperationId)
        && d.backupStartedAt == request.time && d.leaseUpdatedAt == request.time;
    }
    function rootHeartbeat(d) {
      return resource.data.backupStatus == 'in_progress'
        && d.backupGeneration == resource.data.backupGeneration
        && d.backupOperationId == resource.data.backupOperationId
        && d.backupStartedAt == resource.data.backupStartedAt
        && d.leaseUpdatedAt == request.time
        && d.diff(resource.data).affectedKeys().hasOnly(['leaseUpdatedAt','updatedAt']);
    }
    function rootComplete(d) {
      return resource.data.backupStatus == 'in_progress'
        && d.backupGeneration == resource.data.backupGeneration
        && d.backupOperationId == resource.data.backupOperationId
        && d.leaseVersion == resource.data.leaseVersion
        && d.backupStartedAt == resource.data.backupStartedAt
        && d.leaseUpdatedAt == resource.data.leaseUpdatedAt;
    }

    match /userBackups/{uid} {
      // Legacy v1 stays readable by its owner but is immutable under these rules.
      allow get: if owns(uid); allow list, create, update, delete: if false;
      match /{legacyCollection}/{legacyDocument} {
        allow read: if owns(uid) && legacyCollection in ['daily','hourly','sessions','challengeResults','leagueHistory','achievements','settings'];
        allow write: if false;
      }

      match /versions/v2 {
        allow read: if owns(uid); allow create, update: if owns(uid) && validRoot() && times(); allow delete: if false;
        match /daily/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validDaily(id); allow delete: if false; }
        match /hourly/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validHourly(id); allow delete: if false; }
        match /sessions/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validSession(id); allow delete: if false; }
        match /challengeResults/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validMatch(id); allow delete: if false; }
        match /leagueHistory/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validLeague(id); allow delete: if false; }
        match /leagueParticipants/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validLeagueParticipant(id); allow delete: if false; }
        match /seasonHistory/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validSeason(id); allow delete: if false; }
        match /integritySegments/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validIntegrity(id); allow delete: if false; }
        match /achievements/{id} { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validAchievement(id); allow delete: if false; }
        match /settings/current { allow read: if owns(uid); allow create,update: if owns(uid)&&currentGeneration(uid,request.resource.data)&&times()&&validSettings(); allow delete: if false; }
        match /{unknown=**} { allow read,write: if false; }
      }
      match /{unknown=**} { allow read,write: if false; }
    }

    function validDaily(id) { let d=request.resource.data; return date(id)&&date(d.localDate)&&id==d.localDate&&v2(d)
      && d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','steps','unclassifiedSteps','unclassifiedStepsQuality','externalRecoveredSteps','unallocatedMeasuredSteps','distanceMeters','walkingDurationSeconds','caloriesKcal','averageWalkingSpeedKmh','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','activeHourCount','walkingSessionCount','finalized','finalizedAtEpochMillis','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','steps','unclassifiedSteps','unclassifiedStepsQuality','externalRecoveredSteps','unallocatedMeasuredSteps','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','activeHourCount','walkingSessionCount','finalized','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.roomId is string && d.zoneId is string && nn(d.steps)&&nn(d.unclassifiedSteps)&&quality(d.unclassifiedStepsQuality)&&nn(d.externalRecoveredSteps)&&nn(d.unallocatedMeasuredSteps)&&optnn(d.distanceMeters)&&optnn(d.walkingDurationSeconds)&&optnn(d.caloriesKcal)&&optnn(d.averageWalkingSpeedKmh)&&quality(d.stepsQuality)&&quality(d.distanceQuality)&&quality(d.durationQuality)&&quality(d.caloriesQuality)&&quality(d.speedQuality)&&nn(d.activeHourCount)&&nn(d.walkingSessionCount)&&d.finalized is bool&&optnn(d.finalizedAtEpochMillis)&&nn(d.createdAtEpochMillis)&&nn(d.updatedAtEpochMillis); }

    function validHourly(id) { let d=request.resource.data; return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-([01][0-9]|2[0-3])$')&&id==d.localDate+'-'+(d.hourOfDay<10?'0':'')+string(d.hourOfDay)&&v2(d)&&date(d.localDate)&&d.hourOfDay is int&&d.hourOfDay>=0&&d.hourOfDay<=23
      && d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','localDate','hourOfDay','zoneId','utcOffsetSeconds','periodStartEpochMillis','periodEndEpochMillis','steps','distanceMeters','walkingDurationSeconds','caloriesKcal','averageWalkingSpeedKmh','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','firstActivityAtEpochMillis','lastActivityAtEpochMillis','sensorEventCount','recoveredSteps','estimatedSteps','appliedStepLengthMeters','appliedWeightKg','calorieFormulaVersion','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','localDate','hourOfDay','zoneId','utcOffsetSeconds','periodStartEpochMillis','periodEndEpochMillis','steps','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','sensorEventCount','recoveredSteps','estimatedSteps','appliedStepLengthMeters','appliedWeightKg','calorieFormulaVersion','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.roomId is string&&d.zoneId is string&&d.utcOffsetSeconds is int&&d.periodStartEpochMillis is int&&d.periodEndEpochMillis>=d.periodStartEpochMillis&&nn(d.steps)&&optnn(d.distanceMeters)&&optnn(d.walkingDurationSeconds)&&optnn(d.caloriesKcal)&&optnn(d.averageWalkingSpeedKmh)&&quality(d.stepsQuality)&&quality(d.distanceQuality)&&quality(d.durationQuality)&&quality(d.caloriesQuality)&&quality(d.speedQuality)&&optnn(d.firstActivityAtEpochMillis)&&optnn(d.lastActivityAtEpochMillis)&&nn(d.sensorEventCount)&&nn(d.recoveredSteps)&&nn(d.estimatedSteps)&&nn(d.appliedStepLengthMeters)&&nn(d.appliedWeightKg)&&nn(d.calorieFormulaVersion)&&nn(d.createdAtEpochMillis)&&nn(d.updatedAtEpochMillis); }

    function validSession(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&date(d.localDate)&&d.status in ['COMPLETED','RECOVERED']&&d.endedAtEpochMillis is int&&d.endedAtEpochMillis>=d.startedAtEpochMillis
      && d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','steps','distanceMeters','activeDurationSeconds','elapsedDurationSeconds','pausedDurationSeconds','caloriesKcal','averageMovingSpeedKmh','averageElapsedSpeedKmh','sessionType','status','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','trackingServiceSessionId','lastWalkingEventAtEpochMillis','pausedSinceEpochMillis','isManual','detectorEventCount','estimatedStepCount','recoveredStepCount','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','steps','activeDurationSeconds','elapsedDurationSeconds','pausedDurationSeconds','sessionType','status','stepsQuality','distanceQuality','durationQuality','caloriesQuality','speedQuality','isManual','detectorEventCount','estimatedStepCount','recoveredStepCount','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.roomId is string&&d.zoneId is string&&d.startedAtEpochMillis is int&&nn(d.steps)&&optnn(d.distanceMeters)&&nn(d.activeDurationSeconds)&&nn(d.elapsedDurationSeconds)&&nn(d.pausedDurationSeconds)&&optnn(d.caloriesKcal)&&optnn(d.averageMovingSpeedKmh)&&optnn(d.averageElapsedSpeedKmh)&&d.sessionType in ['AUTO_DETECTED','MANUAL_WALK','RANKED_MATCH','RECOVERED']&&quality(d.stepsQuality)&&quality(d.distanceQuality)&&quality(d.durationQuality)&&quality(d.caloriesQuality)&&quality(d.speedQuality)&&d.isManual is bool&&nn(d.detectorEventCount)&&nn(d.estimatedStepCount)&&nn(d.recoveredStepCount)&&nn(d.createdAtEpochMillis)&&nn(d.updatedAtEpochMillis); }

    function validMatch(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&d.status=='FINALIZED'&&d.totalSteps==d.eligibleSteps+d.restrictedSteps+d.excludedSteps&&date(d.localDate)
      && d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','seasonId','seasonStableId','matchType','status','outcome','opponentTargetSteps','totalSteps','eligibleSteps','restrictedSteps','excludedSteps','opponentId','opponentName','opponentAvatarKey','opponentRankTier','opponentRankDivision','opponentPersonality','restrictionReasons','competitiveQuality','ratingBefore','ratingDelta','ratingAfter','finalizedAtEpochMillis','ratingBreakdown','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])
      && d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','seasonId','seasonStableId','matchType','status','opponentTargetSteps','totalSteps','eligibleSteps','restrictedSteps','excludedSteps','opponentId','opponentName','opponentAvatarKey','opponentRankTier','opponentPersonality','restrictionReasons','competitiveQuality','ratingBefore','finalizedAtEpochMillis','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&nn(d.totalSteps)&&nn(d.eligibleSteps)&&nn(d.restrictedSteps)&&nn(d.excludedSteps)&&nn(d.opponentTargetSteps)&&nn(d.finalizedAtEpochMillis)&&d.matchType=='DAILY'&&d.outcome in ['WIN','LOSS','DRAW','NO_CONTEST','CANCELLED']&&d.opponentRankTier in ['BRONZE','SILVER','GOLD','PLATINUM','DIAMOND','MASTER']&&d.opponentPersonality in ['STEADY','SPRINTER','EARLY_BIRD','NIGHT_WALKER','CHALLENGER','RELAXED']&&d.competitiveQuality in ['FULL','RESTRICTED','EXCLUDED']; }

    function validLeague(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&d.status=='FINALIZED'&&date(d.periodStart)&&date(d.periodEnd)&&d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','periodStart','periodEnd','zoneId','status','points','rank','participantsJson','finalizedAtEpochMillis','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','periodStart','periodEnd','zoneId','status','points','participantsJson','finalizedAtEpochMillis','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&d.roomId is string&&d.participantsJson is string&&nn(d.points)&&optnn(d.rank)&&nn(d.finalizedAtEpochMillis); }
    function validLeagueParticipant(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&sid(d.leagueStableId)&&d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','leagueRoomId','leagueStableId','participantId','displayName','avatarKey','points','eligibleSteps','rank','isLocalPlayer','generatedLocally','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','stableId','leagueRoomId','leagueStableId','participantId','displayName','avatarKey','points','eligibleSteps','rank','isLocalPlayer','generatedLocally','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&d.leagueRoomId is string&&d.participantId is string&&d.displayName is string&&d.avatarKey is string&&nn(d.points)&&nn(d.eligibleSteps)&&nn(d.rank)&&d.isLocalPlayer is bool&&d.generatedLocally is bool&&nn(d.createdAtEpochMillis)&&nn(d.updatedAtEpochMillis); }
    function validSeason(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&d.status=='FINALIZED'&&d.endedAtEpochMillis>=d.startedAtEpochMillis&&d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','startedAtEpochMillis','endedAtEpochMillis','status','startRating','endRating','wins','losses','draws','highestRankTier','highestRankDivision','totalEligibleSteps','bestWinStreak','rewardClaimed','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','startedAtEpochMillis','endedAtEpochMillis','status','startRating','wins','losses','draws','highestRankTier','totalEligibleSteps','bestWinStreak','rewardClaimed','createdAtEpochMillis','updatedAtEpochMillis','createdAt','updatedAt'])&&nn(d.wins)&&nn(d.losses)&&nn(d.draws)&&nn(d.totalEligibleSteps)&&nn(d.bestWinStreak)&&d.rewardClaimed is bool&&d.highestRankTier in ['BRONZE','SILVER','GOLD','PLATINUM','DIAMOND','MASTER']; }
    function validIntegrity(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&date(d.localDate)&&d.endedAtEpochMillis>=d.startedAtEpochMillis&&d.totalSteps==d.eligibleSteps+d.restrictedSteps+d.excludedSteps&&d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','totalSteps','eligibleSteps','restrictedSteps','excludedSteps','assessment','reasons','classifierVersion','createdAtEpochMillis','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','stableId','roomId','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','totalSteps','eligibleSteps','restrictedSteps','excludedSteps','assessment','reasons','classifierVersion','createdAtEpochMillis','createdAt','updatedAt'])&&nn(d.totalSteps)&&nn(d.eligibleSteps)&&nn(d.restrictedSteps)&&nn(d.excludedSteps)&&d.assessment in ['TRUSTED','LIMITED','REVIEW','EXCLUDED']&&d.reasons is string&&nn(d.classifierVersion); }
    function validAchievement(id) { let d=request.resource.data; return sid(id)&&v2(d)&&d.stableId==id&&d.keys().hasOnly(['schemaVersion','backupGeneration','stableId','achievementKey','unlockedAtEpochMillis','progressValue','seasonId','seasonStableId','acknowledged','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','stableId','achievementKey','unlockedAtEpochMillis','progressValue','acknowledged','createdAt','updatedAt'])&&d.achievementKey is string&&nn(d.unlockedAtEpochMillis)&&nn(d.progressValue)&&d.acknowledged is bool; }
    function validSettings() { let d=request.resource.data; return d.schemaVersion==2&&d.backupGeneration is int&&d.backupGeneration>=1&&d.keys().hasOnly(['schemaVersion','backupGeneration','heightCm','weightKg','manualStepLengthMeters','useAutomaticStepLength','dailyStepGoal','createdAt','updatedAt'])&&d.keys().hasAll(['schemaVersion','backupGeneration','useAutomaticStepLength','dailyStepGoal','createdAt','updatedAt'])&&optnn(d.heightCm)&&optnn(d.weightKg)&&optnn(d.manualStepLengthMeters)&&d.useAutomaticStepLength is bool&&d.dailyStepGoal is int&&d.dailyStepGoal>=1000&&d.dailyStepGoal<=100000; }
    match /{document=**} { allow read,write: if false; }
    match /matchProfiles/{uid} { allow read: if owns(uid); allow write: if false; }
    match /officialProgress/{uid}/days/{localDate} { allow read: if owns(uid); allow write: if false; }
    match /matchQueue/{uid} { allow read: if owns(uid); allow write: if false; }
    match /challenges/{challengeId} { allow read: if request.auth != null && request.auth.uid in resource.data.participantIds; allow write: if false;
      match /participants/{uid} { allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantIds; allow write: if false; }
    }
    match /requestDeduplication/{uid}/requests/{requestId} { allow read,write: if false; }
  }
}

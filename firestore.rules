rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validCreateTimes() {
      return request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function validUpdateTimes() {
      return request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
    }
    function validTimes() { return resource == null ? validCreateTimes() : validUpdateTimes(); }
    function nonNegative(value) { return value is number && value >= 0; }
    function optionalNonNegative(value) { return value == null || nonNegative(value); }
    function validDate(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validHourlyId(value) { return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-([01][0-9]|2[0-3])$'); }
    function stableId(value) { return value.matches('^[0-9a-f]{32}$'); }

    match /userBackups/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validRoot(true);
      allow update: if owns(uid) && validRoot(false);

      function validRoot(create) {
        let d = request.resource.data;
        return d.keys().hasOnly(['schemaVersion','appVersionName','appVersionCode','databaseVersion',
          'backupGeneration','backupStatus','backupStartedAt','backupCompletedAt','localTimeZone',
          'dailyCount','hourlyCount','sessionCount','challengeResultCount','leagueHistoryCount',
          'achievementCount','newestLocalDate','createdAt','updatedAt'])
          && d.keys().hasAll(['schemaVersion','appVersionName','appVersionCode','databaseVersion',
          'backupGeneration','backupStatus','backupStartedAt','localTimeZone','dailyCount','hourlyCount',
          'sessionCount','challengeResultCount','leagueHistoryCount','achievementCount','createdAt','updatedAt'])
          && d.schemaVersion == 1 && d.appVersionName is string && nonNegative(d.appVersionCode)
          && d.databaseVersion == 10 && d.backupGeneration is int && d.backupGeneration > 0
          && d.backupStatus in ['in_progress','complete'] && d.localTimeZone is string
          && nonNegative(d.dailyCount) && nonNegative(d.hourlyCount) && nonNegative(d.sessionCount)
          && nonNegative(d.challengeResultCount) && nonNegative(d.leagueHistoryCount) && nonNegative(d.achievementCount)
          && (!('newestLocalDate' in d) || d.newestLocalDate == null || validDate(d.newestLocalDate))
          && (create ? d.backupStartedAt == request.time
            : (d.backupStatus == 'in_progress'
              ? d.backupStartedAt == request.time && d.backupGeneration == resource.data.backupGeneration + 1
              : d.backupStartedAt == resource.data.backupStartedAt && d.backupGeneration == resource.data.backupGeneration))
          && (d.backupStatus == 'complete' ? d.backupCompletedAt == request.time : !('backupCompletedAt' in d))
          && (create ? validCreateTimes() : validUpdateTimes());
      }

      match /daily/{date} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && validTimes() && validDaily(date);
      }
      match /hourly/{hour} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && validTimes() && validHourly(hour);
      }
      match /sessions/{id} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && stableId(id) && validTimes() && validSession();
      }
      match /challengeResults/{id} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && stableId(id) && validTimes() && validChallenge();
      }
      match /leagueHistory/{id} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && stableId(id) && validTimes() && validLeague();
      }
      match /achievements/{id} {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && stableId(id) && validTimes() && validAchievement();
      }
      match /settings/current {
        allow get: if owns(uid); allow list, delete: if false;
        allow create, update: if owns(uid) && validTimes() && validSettings();
      }
      match /{unknown=**} { allow read, write: if false; }
    }

    function validDaily(date) {
      let d = request.resource.data;
      return validDate(date) && d.localDate == date
        && d.keys().hasOnly(['schemaVersion','localDate','zoneId','steps','externalRecoveredSteps',
          'unallocatedMeasuredSteps','distanceMeters','walkingDurationSeconds','caloriesKcal','stepsQuality',
          'finalized','finalizedAtEpochMillis','updatedAtEpochMillis','integrityTotal','integrityEligible',
          'integrityRestricted','integrityExcluded','integrityReasons','classifierVersion','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','localDate','zoneId','steps','externalRecoveredSteps',
          'unallocatedMeasuredSteps','stepsQuality','finalized','updatedAtEpochMillis','integrityTotal',
          'integrityEligible','integrityRestricted','integrityExcluded','integrityReasons','classifierVersion','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.zoneId is string && nonNegative(d.steps)
        && nonNegative(d.externalRecoveredSteps) && nonNegative(d.unallocatedMeasuredSteps)
        && optionalNonNegative(d.distanceMeters) && optionalNonNegative(d.walkingDurationSeconds)
        && optionalNonNegative(d.caloriesKcal) && d.stepsQuality is string && d.finalized is bool
        && optionalNonNegative(d.finalizedAtEpochMillis) && nonNegative(d.updatedAtEpochMillis)
        && nonNegative(d.integrityTotal) && nonNegative(d.integrityEligible)
        && nonNegative(d.integrityRestricted) && nonNegative(d.integrityExcluded)
        && d.integrityTotal == d.integrityEligible + d.integrityRestricted + d.integrityExcluded
        && d.integrityReasons is list && nonNegative(d.classifierVersion);
    }

    function validHourly(hour) {
      let d = request.resource.data;
      return validHourlyId(hour) && hour == d.localDate + '-' + (d.hourOfDay < 10 ? '0' : '') + string(d.hourOfDay)
        && d.keys().hasOnly(['schemaVersion','localDate','hourOfDay','zoneId','utcOffsetSeconds','periodStartEpochMillis',
          'periodEndEpochMillis','steps','distanceMeters','walkingDurationSeconds','caloriesKcal','stepsQuality',
          'updatedAtEpochMillis','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','localDate','hourOfDay','zoneId','utcOffsetSeconds','periodStartEpochMillis',
          'periodEndEpochMillis','steps','stepsQuality','updatedAtEpochMillis','createdAt','updatedAt'])
        && d.schemaVersion == 1 && validDate(d.localDate) && d.hourOfDay is int && d.hourOfDay >= 0 && d.hourOfDay <= 23
        && d.zoneId is string && d.utcOffsetSeconds is int && d.periodStartEpochMillis is int
        && d.periodEndEpochMillis is int && d.periodEndEpochMillis >= d.periodStartEpochMillis
        && nonNegative(d.steps) && optionalNonNegative(d.distanceMeters)
        && optionalNonNegative(d.walkingDurationSeconds) && optionalNonNegative(d.caloriesKcal)
        && d.stepsQuality is string && nonNegative(d.updatedAtEpochMillis);
    }

    function validSession() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','steps',
        'distanceMeters','activeDurationSeconds','elapsedDurationSeconds','caloriesKcal','sessionType','status',
        'stepsQuality','updatedAtEpochMillis','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','localDate','zoneId','startedAtEpochMillis','endedAtEpochMillis','steps',
        'activeDurationSeconds','elapsedDurationSeconds','sessionType','status','stepsQuality','updatedAtEpochMillis','createdAt','updatedAt'])
        && d.schemaVersion == 1 && validDate(d.localDate) && d.zoneId is string
        && d.startedAtEpochMillis is int && d.endedAtEpochMillis is int && d.endedAtEpochMillis >= d.startedAtEpochMillis
        && nonNegative(d.steps) && optionalNonNegative(d.distanceMeters) && nonNegative(d.activeDurationSeconds)
        && nonNegative(d.elapsedDurationSeconds) && optionalNonNegative(d.caloriesKcal)
        && d.sessionType is string && d.status in ['COMPLETED','RECOVERED']
        && d.stepsQuality is string && nonNegative(d.updatedAtEpochMillis);
    }

    function validChallenge() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','localDate','zoneId','seasonId','matchType','status','outcome',
        'opponentTargetSteps','totalSteps','eligibleSteps','restrictedSteps','excludedSteps','restrictionReasons',
        'classifierVersion','ratingBefore','ratingDelta','ratingAfter','finalizedAtEpochMillis','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','localDate','zoneId','seasonId','matchType','status','opponentTargetSteps',
        'totalSteps','eligibleSteps','restrictedSteps','excludedSteps','restrictionReasons','classifierVersion',
        'ratingBefore','finalizedAtEpochMillis','createdAt','updatedAt'])
        && d.schemaVersion == 1 && validDate(d.localDate) && d.zoneId is string && stableId(d.seasonId)
        && d.matchType is string && d.status == 'FINALIZED' && nonNegative(d.opponentTargetSteps)
        && nonNegative(d.totalSteps) && nonNegative(d.eligibleSteps) && nonNegative(d.restrictedSteps)
        && nonNegative(d.excludedSteps) && d.totalSteps == d.eligibleSteps + d.restrictedSteps + d.excludedSteps
        && d.restrictionReasons is string && nonNegative(d.classifierVersion) && d.ratingBefore is int
        && nonNegative(d.finalizedAtEpochMillis);
    }

    function validLeague() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','historyType','periodStart','periodEnd','zoneId','status','points','rank',
        'finalizedAtEpochMillis','startedAtEpochMillis','endedAtEpochMillis','startRating','endRating','wins','losses',
        'draws','totalEligibleSteps','bestWinStreak','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','historyType','status','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.historyType in ['WEEKLY_LEAGUE','SEASON'] && d.status == 'FINALIZED';
    }

    function validAchievement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','achievementKey','unlockedAtEpochMillis','progressValue','seasonId',
        'acknowledged','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','achievementKey','unlockedAtEpochMillis','progressValue','acknowledged','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.achievementKey is string && nonNegative(d.unlockedAtEpochMillis)
        && nonNegative(d.progressValue) && (!('seasonId' in d) || d.seasonId == null || stableId(d.seasonId))
        && d.acknowledged is bool;
    }

    function validSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','heightCm','weightKg','manualStepLengthMeters','useAutomaticStepLength',
        'dailyStepGoal','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','useAutomaticStepLength','dailyStepGoal','createdAt','updatedAt'])
        && d.schemaVersion == 1 && optionalNonNegative(d.heightCm) && optionalNonNegative(d.weightKg)
        && optionalNonNegative(d.manualStepLengthMeters) && d.useAutomaticStepLength is bool
        && d.dailyStepGoal is int && d.dailyStepGoal >= 1000 && d.dailyStepGoal <= 100000;
    }

    match /{document=**} { allow read, write: if false; }
  }
}

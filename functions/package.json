{
  "name": "steparena-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test --ext .ts",
    "test": "npm run test:unit",
    "test:unit": "npm run clean && vitest run test --exclude test/emulator.test.ts",
    "test:emulator": "npm run build && vitest run test/emulator.test.ts",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
